{
  "name": "Article",
  "type": "object",
  "properties": {
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "slug": { "type": "string" },
    "series_id": { "type": "string" },
    "series_label": { "type": "string" },
    "series_slug": { "type": "string" },
    "series_order": { "type": "integer", "default": 1 },
    "author_id": { "type": "string" },
    "author_name": { "type": "string" },
    "body_md": {
      "type": "string",
      "description": "Full essay markdown. Field-level access prevents members-only bodies from being returned to anonymous/non-member entity reads; backend service-role functions remain authoritative for gated previews.",
      "rls": {
        "read": {
          "$or": [
            { "data.access_level": "free" },
            { "user_condition": { "role": "admin" } },
            { "user_condition": { "data.membership_status": "active" } },
            { "user_condition": { "data.membership_status": "trialing" } }
          ]
        },
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "excerpt": { "type": "string" },
    "hero_image_url": { "type": "string" },
    "hero_image_caption": { "type": "string" },
    "hero_image_alt": { "type": "string" },
    "hero_image_photographer": { "type": "string" },
    "hero_image_location": { "type": "string" },
    "hero_image_date_label": { "type": "string" },
    "hero_image_collection": { "type": "string" },
    "hero_image_source_url": { "type": "string" },
    "hero_image_rights": { "type": "string" },
    "hero_image_object_position": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["draft", "scheduled", "published", "archived", "featured"],
      "default": "draft"
    },
    "access_level": {
      "type": "string",
      "enum": ["free", "members"],
      "default": "free"
    },
    "featured": { "type": "boolean", "default": false },
    "featured_order": { "type": "integer", "default": 0 },
    "published_at": { "type": "string", "format": "date" },
    "reading_time_mins": { "type": "integer", "default": 9 },
    "view_count": { "type": "integer", "default": 0 },
    "tags": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["title", "slug"]
}
