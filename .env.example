# Copy to .env.local for frontend-only local work against the hosted backend.
VITE_BASE44_APP_ID=6a57ce138c2f29923fec6bc4
VITE_BASE44_APP_BASE_URL=https://humanweather.base44.app

# Public site origin (Checkout success/cancel URLs — set as Base44 function secret SITE_URL)
SITE_URL=https://humanweather.vercel.app

# Stripe secrets belong in Base44 function secrets (NOT Vercel), used by:
# createCheckout, createPortal, stripeWebhook, verifyAppAccess
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_MEMBER_MONTHLY=price_1TvRUwL5xkl5Azg8hpLAksIu
# STRIPE_PRICE_MEMBER_YEARLY=price_1TvRUxL5xkl5Azg8b4m7xmZh
# STRIPE_PRICE_MEMBER_APP_YEARLY=price_1TvRUyL5xkl5Azg8afW0Kfau
# HW_SOCIAL_APP_URL=https://humanweather.social
