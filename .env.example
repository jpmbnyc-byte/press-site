# Copy to .env.local for frontend-only local work against the hosted backend.
VITE_BASE44_APP_ID=6a57ce138c2f29923fec6bc4
VITE_BASE44_APP_BASE_URL=https://humanweather.base44.app

# Public site origin (used by Stripe success/cancel/portal return URLs)
SITE_URL=https://www.humanweather.press

# Stripe — set in Vercel Production (and Preview if testing). Never commit real keys.
# Prefer a restricted key (rk_live_... / rk_test_...) over sk_*.
STRIPE_SECRET_KEY=
STRIPE_PRICE_MEMBER_MONTHLY=
STRIPE_PRICE_MEMBER_YEARLY=
STRIPE_PRICE_MEMBER_APP_YEARLY=
STRIPE_WEBHOOK_SECRET=
