# Copy to .env.local for frontend-only local development against the hosted backend.
VITE_BASE44_APP_ID=6a57ce138c2f29923fec6bc4
VITE_BASE44_APP_BASE_URL=https://humanweather.base44.app

# Optional: force SDK API host (defaults to https://base44.app in production builds).
# Leave unset for local `npm run dev` so requests stay on /api (Vite proxy).
# VITE_BASE44_SERVER_URL=https://base44.app
